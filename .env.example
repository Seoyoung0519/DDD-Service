# Metro/Expo 재시작 후 반영됩니다. 반드시 UTF-8(메모장 저장 시 "UTF-8" 선택)로 저장하세요.
# 복사: cp .env.example .env  (또는 .env.local)

# 메인 API (daedokdan-api) — 통근 경로, 읽기 세션 등
# 백엔드에서 발급한 키. 없거나 틀리면 502 / ApiKeyAuthFailed 가 날 수 있습니다.
EXPO_PUBLIC_DAEDOKDAN_API_KEY=

# 카카오 로그인 — 카카오 개발자 콘솔 앱 키 (네이티브 앱 키 필수, 변경 후 prebuild·앱 재빌드)
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# Google Maps — 독서 세션 지도 탭 (Android 필수, 변경 후 prebuild·앱 재빌드)
# Google Cloud Console → Maps SDK for Android/iOS 활성화, 키 제한: com.daedokdan.app
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# 에뮬레이터: GPS 대신 선택한 통근 경로 지점을 수동/자동 이동 (실제 경로 segments 기준)
# false = 실제 기기 GPS 위치 기반 독서 세션
EXPO_PUBLIC_DEMO_COMMUTE_LOCATION=false

# 통근 경로 API 실패 시 데모 경로로 결과 화면 진행 (미설정 시 DEMO_COMMUTE_LOCATION=true 일 때 자동)
# EXPO_PUBLIC_COMMUTE_ROUTES_DEV_FALLBACK=true

# 출·도착 검색(RS4) 건너뛰기 — true일 때만 데모 경로로 바로 분량 추천
EXPO_PUBLIC_SKIP_COMMUTE_ROUTE_SEARCH=false

# 웹 카카오 로그인용 (선택)
EXPO_PUBLIC_KAKAO_JAVASCRIPT_KEY=
EXPO_PUBLIC_KAKAO_REST_API_KEY=

# 선택: 메인·로그인 API 베이스 URL 오버라이드
# EXPO_PUBLIC_MAIN_API_BASE_URL=https://daedokdan-api.onrender.com
# EXPO_PUBLIC_BANNER_API_BASE_URL=https://daedokdan-api.onrender.com
# EXPO_PUBLIC_ADMIN_API_BASE_URL=https://daedokdan-api.onrender.com
# EXPO_PUBLIC_SETTINGS_API_BASE_URL=https://daedokdan-api-8s8k.onrender.com
# EXPO_PUBLIC_LOGIN_API_BASE_URL=https://daedokdan-login.onrender.com

# 내 서재 요약 GET /library/summary — 기본은 확장 호스트
# EXPO_PUBLIC_LIBRARY_API_BASE_URL=https://daedokdan-api-8s8k.onrender.com

# 찜하기 POST 경로 (405 시 백엔드 OpenAPI에 맞게 지정). 기본: /library/wishlist/items
# EXPO_PUBLIC_LIBRARY_WISHLIST_ADD_PATH=/library/wishlist/items

# 사용자 프로필 GET/PATCH `/user/profile` — 기본은 확장 호스트
# EXPO_PUBLIC_USER_API_BASE_URL=https://daedokdan-api-8s8k.onrender.com

# 키링 GET /keyrings — 기본은 확장 호스트. 메인 API에만 있으면 여기에 메인 URL 지정
# EXPO_PUBLIC_KEYRING_API_BASE_URL=https://daedokdan-api.onrender.com
# image_path가 상대경로일 때 붙일 호스트(미설정 시 KEYRING_API_BASE_URL과 동일)
# EXPO_PUBLIC_KEYRING_MEDIA_BASE_URL=https://daedokdan-api.onrender.com

# 독서 인증샷 POST /proofs/upload
# ⚠️ Render 로그는 daedokdan-api-8s8k 서비스에서 확인 (daedokdan-api 메인에는 없음)
# EXPO_PUBLIC_PROOF_API_BASE_URL=https://daedokdan-api-8s8k.onrender.com
# 인증샷 image_path가 상대경로일 때 붙일 호스트 (미설정 시 PROOF_API_BASE_URL과 동일)
# EXPO_PUBLIC_PROOF_MEDIA_BASE_URL=https://daedokdan-api-8s8k.onrender.com
